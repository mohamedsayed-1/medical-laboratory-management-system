@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Add Appointment</h3>
            </div>

            <div class="card-body">
                <p>
                    Create a new patient appointment and request laboratory tests.
                </p>

                <a asp-controller="Appointment"
                   asp-action="AddAppointment"
                   class="btn btn-primary">
                    Add Appointment
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Appointment Status & Results</h3>
            </div>

            <div class="card-body">
                <p>
                    Check appointment status and view laboratory test results.
                </p>

                <a asp-controller="Result"
                   asp-action="Index"
                   class="btn btn-primary">
                    Check Results
                </a>
            </div>
        </div>
    </div>
</div>
