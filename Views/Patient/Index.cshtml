@model IEnumerable<Medical_Laboratory_Management_System.View_Models.IndexPatient>

<h1>All Patients</h1>

<p>
    <a asp-action="AddAppointment" asp-controller="Appointment" class="btn btn-success">Add New Appointment</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Age
            </th>
            <th>
                Gender
            </th>
            <th>
                PhoneNumber
            </th>
            <th>
                Email
            </th>
            <th>
                MaritalStatus
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Age)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Gender)
                </td>
                <td>
                    @Html.DisplayFor(model => item.PhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(model => item.MaritalStatus)
                </td>
                <td>
                    <input hidden value="@item.Id"/>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success">Edit</a> &nbsp;
                </td>
            </tr>
        }
    </tbody>
</table>
