@model IEnumerable<Medical_Laboratory_Management_System.View_Models.IndexAppointmentViewModel>

<h1>All Appointments</h1>

<p>
    <a asp-action="AddAppointment" class="btn btn-success">Add New Appointment</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Patient
            </th>
            <th>
                Date
            </th>
            <th>
                Urgent
            </th>
            <th>
                Doctor
            </th>
            <th>
                Notes
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.PatientName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Date)
            </td>
            <td>
                @Html.DisplayFor(model => item.Urgent)
            </td>
            <td>
                @Html.DisplayFor(model => item.DoctorName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Notes)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.AppointmentId" class="btn btn-success">Edit</a> &nbsp;
                    <a asp-action="Details" asp-route-id="@item.AppointmentId" class="btn btn-success">Details</a> &nbsp;
                <form asp-action="Delete" method="post" asp-route-id="@item.AppointmentId" style="display:inline">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this appointment?');">Delete</button>
                </form> 
            </td>
        </tr>
}
    </tbody>
</table>
